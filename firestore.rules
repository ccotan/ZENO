copper_chain","weathered_copper_golem_statue","weathered_copper_grate","weathered_copper_lantern","weathered_cut_copper","weathered_cut_copper_slab","weathered_cut_copper_stairs","weathered_lightning_rod","weeping_vines","wet_sponge","wheat","wheat_seeds","white_banner","white_bed","white_bundle","white_candle","white_carpet","white_concrete","white_concrete_powder","white_dye","white_glazed_terracotta","white_harness","white_shulker_box","white_stained_glass","white_stained_glass_pane","white_terracotta","white_tulip","white_wool","wild_armor_trim_smithing_template","wildflowers","wind_charge","wither_rose","wither_skeleton_skull","wolf_armor","wooden_axe","wooden_hoe","wooden_pickaxe","wooden_shovel","wooden_spear","wooden_sword","writable_book","written_book"]) || (k.matches("y.*") && k in ["yellow_banner","yellow_bed","yellow_bundle","yellow_candle","yellow_carpet","yellow_concrete","yellow_concrete_powder","yellow_dye","yellow_glazed_terracotta","yellow_harness","yellow_shulker_box","yellow_stained_glass","yellow_stained_glass_pane","yellow_terracotta","yellow_wool"]) || (k.matches("z.*") && k in ["zombie_head"]);}
  function profileOK(d){return d.keys().hasAll(['minecraftName','createdAt','updatedAt']) && d.keys().hasOnly(['minecraftName','displayName','createdAt','updatedAt']) && d.minecraftName is string && d.minecraftName.matches('[A-Za-z0-9_]{3,16}') && (!('displayName' in d) || (d.displayName is string && d.displayName.size()<=80)) && d.createdAt is timestamp && d.updatedAt==request.time;}
  match /users/{uid} {
   allow get:if signed() && (request.auth.uid==uid || staff());
   allow list:if staff() && bounded(50);
   allow update,delete:if false;
   allow create:if false;
   match /favorites/{key} {
    allow get,delete:if signed() && request.auth.uid==uid;
    allow list:if signed() && request.auth.uid==uid && bounded(100);
    allow create:if active() && request.auth.uid==uid && favoriteOK(request.resource.data,key);
    allow update:if false;
   }
   match /drafts/{id} {
    allow get,delete:if signed() && request.auth.uid==uid;
    allow list:if false;
    allow create,update:if active() && request.auth.uid==uid && id=='current' && draftOK(request.resource.data);
   }
   match /reads/{id} {
    allow get,delete:if signed() && request.auth.uid==uid;
    allow list:if signed() && request.auth.uid==uid && bounded(200);
    allow create,update:if signed() && request.auth.uid==uid && id.size()<=220 && request.resource.data.keys().hasOnly(['seenAt']) && request.resource.data.seenAt==request.time;
   }
  }
  // Only the profile owner may publish a server-timestamped heartbeat.
  // Presence is a UI hint, never a trade authorization proof.
  match /sitePresence/{id} {
   allow get:if pid(id);
   allow list,delete:if false;
   allow create:if active() && pid(id) && owner(id) && exists(/databases/$(database)/documents/publicProfiles/$(id)) && request.resource.data.keys().hasAll(['seenAt']) && request.resource.data.keys().hasOnly(['seenAt']) && request.resource.data.seenAt==request.time;
   allow update:if active() && pid(id) && owner(id) && exists(/databases/$(database)/documents/publicProfiles/$(id)) && request.resource.data.keys().hasAll(['seenAt']) && request.resource.data.keys().hasOnly(['seenAt']) && request.resource.data.seenAt==request.time && request.time>=resource.data.seenAt+duration.value(55,'s');
  }
  match /publicProfiles/{id} {
   allow get:if true;
   allow list:if staff() && bounded(50);
   allow delete:if false;
   allow create,update:if false;
  }
  function favoriteOK(d,key){
   return d.keys().hasAll(['kind','sellerId','lotDoc','generationId','createdAt']) && d.keys().hasOnly(['kind','sellerId','lotDoc','generationId','createdAt']) && pid(d.sellerId) && d.createdAt==request.time && (
    (d.kind=='seller' && d.lotDoc=='' && d.generationId=='' && key=='s_'+d.sellerId && exists(/databases/$(database)/documents/publicProfiles/$(d.sellerId))) ||
    (d.kind=='lot' && uuid(d.generationId) && key=='l_'+d.lotDoc+'_'+d.generationId && get(/databases/$(database)/documents/lots/$(d.lotDoc)).data.id==d.generationId && get(/databases/$(database)/documents/lots/$(d.lotDoc)).data.sellerId==d.sellerId));
  }
  function draftOK(d){return d.keys().hasAll(['itemKey','quantity','unitPrice','customName','traitData','updatedAt']) && d.keys().hasOnly(['itemKey','quantity','unitPrice','customName','traitData','updatedAt']) && validItem(d.itemKey) && amountsOK(d) && d.customName is string && d.customName.size()<=80 && d.traitData is string && d.traitData.size()<=6000 && d.updatedAt==request.time;}
  function amountsOK(d){return d.quantity is int && d.quantity>=1 && d.quantity<=1000000 && d.unitPrice is int && d.unitPrice>=1 && d.unitPrice<=1000000000 && d.quantity*d.unitPrice<=9007199254740991;}
  function av(d){return d.get('availableQty',d.quantity);}
  function res(d){return d.get('reservedQty',0);}
  function sold(d){return d.get('soldQty',0);}
  function stockOK(d){return d.availableQty is int && d.reservedQty is int && d.soldQty is int && d.availableQty>=0 && d.reservedQty>=0 && d.soldQty>=0 && d.availableQty+d.reservedQty+d.soldQty==d.quantity && d.updatedAt==request.time;}
  function lotCreate(d,id){return queued('lot',id,'') && d.keys().hasAll(['id','sellerId','slot','itemKey','nickname','quantity','unitPrice','customName','traitData','createdAt','updatedAt','availableQty','reservedQty','soldQty','lastOperationId','lastOperation','hasPhoto']) && d.keys().hasOnly(['id','sellerId','slot','itemKey','nickname','quantity','unitPrice','customName','traitData','createdAt','updatedAt','availableQty','reservedQty','soldQty','lastOperationId','lastOperation','hasPhoto','visibility']) && active() && tradeAllowed(d.sellerId) && visibility(d)=='active' && owner(d.sellerId) && pid(d.sellerId) && d.slot is int && d.slot>=0 && d.slot<50 && id==d.sellerId+'_'+string(d.slot) && uuid(d.id) && validItem(d.itemKey) && amountsOK(d) && d.nickname==get(/databases/$(database)/documents/publicProfiles/$(d.sellerId)).data.minecraftName && d.nickname.matches('[A-Za-z0-9_]{3,16}') && d.customName is string && d.customName.size()<=80 && d.traitData is string && d.traitData.size()<=6000 && d.createdAt==request.time && stockOK(d) && d.availableQty==d.quantity && d.reservedQty==0 && d.soldQty==0 && d.lastOperationId=='' && d.lastOperation=='' && d.hasPhoto is bool && (!d.hasPhoto || getAfter(/databases/$(database)/documents/lotPhotos/$(id)).data.generationId==d.id);}
  function stockAfter(lotDoc,gen,dealId,op,q){
   let before=get(/databases/$(database)/documents/lots/$(lotDoc)).data;
   let after=getAfter(/databases/$(database)/documents/lots/$(lotDoc)).data;
   return before.id==gen && after.id==gen && after.lastOperationId==dealId && after.lastOperation==op && after.updatedAt==request.time &&
    ((op=='reserve' && after.availableQty==av(before)-q && after.reservedQty==res(before)+q && after.soldQty==sold(before)) ||
     (op=='release' && after.availableQty==av(before)+q && after.reservedQty==res(before)-q && after.soldQty==sold(before)) ||
     (op=='complete' && after.availableQty==av(before) && after.reservedQty==res(before)-q && after.soldQty==sold(before)+q));
  }
  function lotStockUpdate(d,id){
   let order=getAfter(/databases/$(database)/documents/deals/$(d.lastOperationId)).data;
   return signed() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availableQty','reservedQty','soldQty','lastOperationId','lastOperation','updatedAt']) && stockOK(d) && order.lotDoc==id && order.lotGenerationId==d.id && member(order) && order.updatedAt==request.time && stockAfter(id,d.id,d.lastOperationId,d.lastOperation,order.quantity) && (
    (d.lastOperation=='reserve' && !exists(/databases/$(database)/documents/deals/$(d.lastOperationId)) && order.status=='pending' && owner(order.buyerId)) ||
    (d.lastOperation=='release' && get(/databases/$(database)/documents/deals/$(d.lastOperationId)).data.status in ['pending','accepted'] && order.status=='cancelled' && owner(order.cancelledBy)) ||
    (d.lastOperation=='complete' && get(/databases/$(database)/documents/deals/$(d.lastOperationId)).data.status=='accepted' && order.status=='completed' && order.buyerConfirmed && order.sellerConfirmed));
  }
  function ownLotEdit(d){return queued('lot',resource.data.sellerId+'_'+string(resource.data.slot),'') && active() && (tradeAllowed(resource.data.sellerId) || (d.get('salePaused',false)==true && d.diff(resource.data).affectedKeys().hasOnly(['salePaused','updatedAt']))) && owner(resource.data.sellerId) && visibility(resource.data)=='active' && d.diff(resource.data).affectedKeys().hasOnly(['unitPrice','quantity','availableQty','customName','salePaused','updatedAt']) && amountsOK(d) && stockOK(d) && d.reservedQty==res(resource.data) && d.soldQty==sold(resource.data) && d.customName is string && d.customName.size()<=80 && d.get('salePaused',false) is bool;}
  function ownLotBump(d){return active() && tradeAllowed(resource.data.sellerId) && owner(resource.data.sellerId) && visibility(resource.data)=='active' && !resource.data.get('salePaused',false) && av(resource.data)>0 && d.diff(resource.data).affectedKeys().hasOnly(['createdAt','bumpedAt','publishedAt','updatedAt']) && d.createdAt==request.time && d.bumpedAt==request.time && d.updatedAt==request.time && d.publishedAt==resource.data.get('publishedAt',resource.data.createdAt) && (!('bumpedAt' in resource.data) || request.time>=resource.data.bumpedAt+duration.value(24,'h'));}
  match /lots/{id} {
   allow get:if true;
   allow list:if bounded(500);
   allow create:if lotCreate(request.resource.data,id);
   allow update:if ownLotEdit(request.resource.data) || ownLotBump(request.resource.data) || lotStockUpdate(request.resource.data,id) || lotModerate(request.resource.data,id);
   allow delete:if (owner(resource.data.sellerId) && res(resource.data)==0 && !existsAfter(/databases/$(database)/documents/lotPhotos/$(id))) || staffDeleteLot(id);
  }
  match /lotPhotos/{id} {
   allow get:if true;
   allow list,update:if false;
   allow create:if request.resource.data.keys().hasAll(['sellerId','generationId','data','createdAt']) && request.resource.data.keys().hasOnly(['sellerId','generationId','data','createdAt']) && owner(request.resource.data.sellerId) && request.resource.data.createdAt==request.time && request.resource.data.data is string && request.resource.data.data.size()<=245760 && request.resource.data.data.matches('data:image/webp;base64,[A-Za-z0-9+/=]+') && getAfter(/databases/$(database)/documents/lots/$(id)).data.id==request.resource.data.generationId && getAfter(/databases/$(database)/documents/lots/$(id)).data.sellerId==request.resource.data.sellerId && getAfter(/databases/$(database)/documents/lots/$(id)).data.hasPhoto==true;
   allow delete:if (owner(resource.data.sellerId) || manager()) && !existsAfter(/databases/$(database)/documents/lots/$(id));
  }
  function threadCreate(d,id){
   let l=exists(/databases/$(database)/documents/lots/$(d.lotDoc))?get(/databases/$(database)/documents/lots/$(d.lotDoc)).data:{};
   return d.keys().hasAll(['sellerId','buyerId','members','lotDoc','lotGenerationId','itemKey','title','createdAt','updatedAt','lastMessageId','lastSenderId']) && d.keys().hasOnly(['sellerId','buyerId','members','lotDoc','lotGenerationId','itemKey','title','createdAt','updatedAt','lastMessageId','lastSenderId','dealId']) && active() && d.sellerId!=d.buyerId && ((visibility(l)=='active' && owner(d.buyerId) && d.sellerId==l.sellerId && d.lotGenerationId==l.id && d.itemKey==l.itemKey && d.title==l.customName) || threadDeal(d)) && d.members==[d.sellerId,d.buyerId] && id==d.lotDoc+'~'+d.lotGenerationId+'~'+d.buyerId && d.createdAt==request.time && d.updatedAt==request.time && d.lastMessageId=='' && d.lastSenderId=='';
  }
  function threadUpdate(d,id){let msg=getAfter(/databases/$(database)/documents/threads/$(id)/messages/$(d.lastMessageId)).data;return active() && member(resource.data) && d.diff(resource.data).affectedKeys().hasOnly(['lastMessageId','lastSenderId','updatedAt']) && uuid(d.lastMessageId) && owner(d.lastSenderId) && d.updatedAt==request.time && msg.createdAt==request.time && msg.senderId==d.lastSenderId;}
  match /threads/{id} {
   allow get:if signed() && (!exists(/databases/$(database)/documents/threads/$(id)) || member(resource.data));
   allow list:if bounded(100) && member(resource.data);
   allow create:if threadCreate(request.resource.data,id);
   allow update:if threadUpdate(request.resource.data,id);
   allow delete:if false;
   match /messages/{messageId} {
    allow get:if member(get(/databases/$(database)/documents/threads/$(id)).data);
    allow list:if bounded(50) && member(get(/databases/$(database)/documents/threads/$(id)).data);
    allow create:if active() && uuid(messageId) && request.resource.data.keys().hasAll(['senderId','body','createdAt']) && request.resource.data.keys().hasOnly(['senderId','body','createdAt','replyTo']) && owner(request.resource.data.senderId) && member(get(/databases/$(database)/documents/threads/$(id)).data) && request.resource.data.body is string && request.resource.data.body.size()>=1 && request.resource.data.body.size()<=2000 && request.resource.data.createdAt==request.time && (request.resource.data.get('replyTo','')=='' || (uuid(request.resource.data.replyTo) && exists(/databases/$(database)/documents/threads/$(id)/messages/$(request.resource.data.replyTo)))) && getAfter(/databases/$(database)/documents/threads/$(id)).data.lastMessageId==messageId && getAfter(/databases/$(database)/documents/threads/$(id)).data.lastSenderId==request.resource.data.senderId && getAfter(/databases/$(database)/documents/threads/$(id)).data.updatedAt==request.time;
    allow update:if active() && owner(resource.data.senderId) && member(get(/databases/$(database)/documents/threads/$(id)).data) && resource.data.get('deleted',false)==false && request.time<=resource.data.createdAt+duration.value(15,'m') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body','editedAt','deleted']) && request.resource.data.editedAt==request.time && request.resource.data.body is string && ((request.resource.data.get('deleted',false)==true && request.resource.data.body=='') || (request.resource.data.get('deleted',false)==false && request.resource.data.body.size()>=1 && request.resource.data.body.size()<=2000));
    allow delete:if false;
   }
  }
  function dealCreate(d,id){
   let l=get(/databases/$(database)/documents/lots/$(d.lotDoc)).data;
   return uuid(id) && d.keys().hasAll(['sellerId','buyerId','members','lotDoc','lotGenerationId','itemKey','title','quantity','unitPrice','total','status','buyerConfirmed','sellerConfirmed','cancelledBy','createdAt','updatedAt']) && d.keys().hasOnly(['sellerId','buyerId','members','lotDoc','lotGenerationId','itemKey','title','quantity','unitPrice','total','status','buyerConfirmed','sellerConfirmed','cancelledBy','createdAt','updatedAt']) && active() && bothAllowed(d) && visibility(l)=='active' && !l.get('salePaused',false) && owner(d.buyerId) && d.sellerId!=d.buyerId && d.sellerId==l.sellerId && d.members==[d.sellerId,d.buyerId] && d.lotGenerationId==l.id && d.itemKey==l.itemKey && d.title==l.customName && amountsOK(d) && d.unitPrice==l.unitPrice && d.quantity<=av(l) && d.total==d.quantity*d.unitPrice && d.status=='pending' && d.buyerConfirmed==false && d.sellerConfirmed==false && d.cancelledBy=='' && d.createdAt==request.time && d.updatedAt==request.time && stockAfter(d.lotDoc,d.lotGenerationId,id,'reserve',d.quantity);
  }
  function confirms(d){return (owner(resource.data.buyerId) && !resource.data.buyerConfirmed && d.buyerConfirmed==true && d.sellerConfirmed==resource.data.sellerConfirmed) || (owner(resource.data.sellerId) && !resource.data.sellerConfirmed && d.sellerConfirmed==true && d.buyerConfirmed==resource.data.buyerConfirmed);}
  function dealUpdate(d,id){return member(resource.data) && d.diff(resource.data).affectedKeys().hasOnly(['status','buyerConfirmed','sellerConfirmed','cancelledBy','updatedAt']) && d.updatedAt==request.time && (
   (active() && bothAllowed(d) && request.time<resource.data.createdAt+duration.value(48,'h') && resource.data.status=='pending' && d.status=='accepted' && owner(d.sellerId) && !d.buyerConfirmed && !d.sellerConfirmed && d.cancelledBy=='') ||
   (resource.data.status in ['pending','accepted'] && d.status=='cancelled' && owner(d.cancelledBy) && d.buyerConfirmed==resource.data.buyerConfirmed && d.sellerConfirmed==resource.data.sellerConfirmed && stockAfter(d.lotDoc,d.lotGenerationId,id,'release',d.quantity)) ||
   (active() && bothAllowed(d) && request.time<resource.data.createdAt+duration.value(48,'h') && resource.data.status=='accepted' && confirms(d) && d.cancelledBy=='' && ((d.status=='accepted' && !(d.buyerConfirmed && d.sellerConfirmed)) || (d.status=='completed' && queued('trade',id,'') && d.buyerConfirmed && d.sellerConfirmed && stockAfter(d.lotDoc,d.lotGenerationId,id,'complete',d.quantity)))));
  }
  match /deals/{id} {
   allow get:if member(resource.data);
   allow list:if bounded(100) && member(resource.data);
   allow create:if dealCreate(request.resource.data,id);
   allow update:if dealUpdate(request.resource.data,id);
   allow delete:if false;
  }
  match /itemSubscriptions/{id}{
   allow get,delete:if signed() && resource.data.ownerUid==request.auth.uid;
   allow list:if signed() && bounded(50) && resource.data.ownerUid==request.auth.uid;
   allow create,update:if active() && request.resource.data.keys().hasAll(['ownerUid','itemKey','maxPrice','enabled','updatedAt']) && request.resource.data.keys().hasOnly(['ownerUid','itemKey','maxPrice','enabled','updatedAt']) && request.resource.data.ownerUid==request.auth.uid && id==request.auth.uid+'_'+request.resource.data.itemKey && validItem(request.resource.data.itemKey) && request.resource.data.maxPrice is int && request.resource.data.maxPrice>=2 && request.resource.data.maxPrice<=1000000000 && request.resource.data.enabled is bool && request.resource.data.updatedAt==request.time;
  }
  match /users/{uid}/alerts/{id}{allow get:if signed() && request.auth.uid==uid;allow list:if signed() && request.auth.uid==uid && bounded(50);allow update:if signed() && request.auth.uid==uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) && request.resource.data.read==true;allow create,delete:if false;}
  match /sellerStats/{id}{allow get:if true;allow list,write:if false;}
  match /itemStats/{id}{allow get:if true;allow list,write:if false;}
  match /systemStatus/{id}{allow get:if id=='trading';allow list,write:if false;}
  match /{document=**}{allow read,write:if false;}
 }
}
