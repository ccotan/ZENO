rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth != null && request.auth.uid.matches('discord:[0-9]{17,20}');}

  function accountUid(uid){return uid is string && uid.matches('discord:[0-9]{17,20}');}
  function blocked(uid){return exists(/databases/$(database)/documents/userBlocks/$(uid)) && get(/databases/$(database)/documents/userBlocks/$(uid)).data.blocked==true;}
  function tradeAllowed(id){let p=get(/databases/$(database)/documents/tradeAccess/$(id)).data;return p.allowed==true && !blocked(p.ownerUid) && p.checkedAt<=request.time && request.time<p.checkedAt+duration.value(60,'s') && get(/databases/$(database)/documents/publicProfiles/$(id)).data.minecraftVerified==true;}
  function bothAllowed(d){return tradeAllowed(d.sellerId) && tradeAllowed(d.buyerId);}
  match /tradeAccess/{id}{allow get:if signed() && owner(id);allow list,write:if false;}
  function queued(kind,target,seller){let id=kind+'_'+(seller==''?'':seller+'_')+target;let q=getAfter(/databases/$(database)/documents/marketJobs/$(id)).data;return q.kind==kind && q.target==target && q.sellerId==seller && q.createdAt==request.time && q.queuedAt==request.time;}
  function validJob(d,id){return active() && d.keys().hasAll(['kind','target','sellerId','createdAt','queuedAt']) && d.keys().hasOnly(['kind','target','sellerId','createdAt','queuedAt']) && d.createdAt==request.time && d.queuedAt==request.time && d.target is string && d.sellerId is string && (
   (d.kind=='lot' && d.sellerId=='' && id=='lot_'+d.target && owner(getAfter(/databases/$(database)/documents/lots/$(d.target)).data.sellerId) && getAfter(/databases/$(database)/documents/lots/$(d.target)).data.updatedAt==request.time) ||
   (d.kind=='trade' && uuid(d.target) && d.sellerId=='' && id=='trade_'+d.target && member(getAfter(/databases/$(database)/documents/deals/$(d.target)).data) && getAfter(/databases/$(database)/documents/deals/$(d.target)).data.status=='completed' && getAfter(/databases/$(database)/documents/deals/$(d.target)).data.updatedAt==request.time) ||
   (d.kind=='review' && pid(d.sellerId) && uuid(d.target) && id=='review_'+d.sellerId+'_'+d.target && ((owner(getAfter(/databases/$(database)/documents/publicProfiles/$(d.sellerId)/reviews/$(d.target)).data.authorId) && getAfter(/databases/$(database)/documents/publicProfiles/$(d.sellerId)/reviews/$(d.target)).data.createdAt==request.time) || (staff() && getAfter(/databases/$(database)/documents/publicProfiles/$(d.sellerId)/reviews/$(d.target)).data.moderatedAt==request.time)))
  );}
  match /marketJobs/{id}{allow create,update:if validJob(request.resource.data,id);allow read,delete:if false;}
  function active(){return signed() && !blocked(request.auth.uid);}
  function roleOf(uid){return exists(/databases/$(database)/documents/staff/$(uid))?get(/databases/$(database)/documents/staff/$(uid)).data.role:'none';}
  function staff(){return active() && roleOf(request.auth.uid) in ['owner','admin','moderator'];}
  function manager(){return active() && roleOf(request.auth.uid) in ['owner','admin'];}
  function root(){return active() && roleOf(request.auth.uid)=='owner';}
  function visibility(d){return d.get('visibility','active');}
  function reasonOK(s){return s is string && s.size()>=8 && s.size()<=500;}
  function auditMatches(id,action,kind,target,gen,reason){
   let e=getAfter(/databases/$(database)/documents/auditLog/$(id)).data;
   return !exists(/databases/$(database)/documents/auditLog/$(id)) && e.actorUid==request.auth.uid && e.action==action && e.targetKind==kind && e.targetId==target && e.targetGeneration==gen && e.reason==reason && e.createdAt==request.time;
  }
  function lotModerate(d,id){return staff() && d.diff(resource.data).affectedKeys().hasOnly(['visibility','moderationReason','moderatedAt','lastAuditId']) && d.visibility in ['active','hidden'] && visibility(resource.data)!=d.visibility && reasonOK(d.moderationReason) && d.moderatedAt==request.time && uuid(d.lastAuditId) && auditMatches(d.lastAuditId,d.visibility=='hidden'?'lot-hide':'lot-show','lot',id,d.id,d.moderationReason);}
  function staffDeleteLot(id){return manager() && res(resource.data)==0 && !existsAfter(/databases/$(database)/documents/lotPhotos/$(id)) && auditMatches('delete_'+id+'_'+resource.data.id,'lot-delete','lot',id,resource.data.id,getAfter(/databases/$(database)/documents/auditLog/$('delete_'+id+'_'+resource.data.id)).data.reason);}
  function roleWrite(d,uid){return root() && accountUid(uid) && uid!=request.auth.uid && roleOf(uid)!='owner' && !blocked(uid) && exists(/databases/$(database)/documents/users/$(uid)) && d.keys().hasAll(['role','assignedBy','createdAt','updatedAt','lastAuditId']) && d.keys().hasOnly(['role','assignedBy','createdAt','updatedAt','lastAuditId']) && d.role in ['admin','moderator','none'] && d.assignedBy==request.auth.uid && d.updatedAt==request.time && d.createdAt is timestamp && uuid(d.lastAuditId) && d.role!=roleOf(uid) && auditMatches(d.lastAuditId,'role-set','user',uid,'',getAfter(/databases/$(database)/documents/auditLog/$(d.lastAuditId)).data.reason);}
  function blockWrite(d,uid){return manager() && accountUid(uid) && uid!=request.auth.uid && roleOf(uid)!='owner' && (root() || roleOf(uid)=='none') && exists(/databases/$(database)/documents/users/$(uid)) && d.keys().hasAll(['blocked','reason','updatedAt','lastAuditId']) && d.keys().hasOnly(['blocked','reason','updatedAt','lastAuditId']) && d.blocked is bool && d.blocked!=blocked(uid) && reasonOK(d.reason) && d.updatedAt==request.time && uuid(d.lastAuditId) && auditMatches(d.lastAuditId,d.blocked?'user-block':'user-unblock','user',uid,'',d.reason);}
  match /staff/{uid}{
   allow get:if signed() && (request.auth.uid==uid || staff());
   allow list:if staff() && bounded(50);
   allow create:if roleWrite(request.resource.data,uid) && request.resource.data.createdAt==request.time;
   allow update:if roleWrite(request.resource.data,uid) && request.resource.data.createdAt==resource.data.createdAt;
   allow delete:if false;
  }
  match /userBlocks/{uid}{
   allow get:if signed() && (request.auth.uid==uid || staff());
   allow list:if staff() && bounded(50);
   allow create,update:if blockWrite(request.resource.data,uid);
   allow delete:if false;
  }
  function reportTarget(d,id){return
   (active() && d.targetKind=='lot' && d.targetId is string && d.targetId.size()<=60 && uuid(d.targetGeneration) && get(/databases/$(database)/documents/lots/$(d.targetId)).data.id==d.targetGeneration && id=='lot_'+d.targetId+'_'+d.targetGeneration+'_'+request.auth.uid) ||
   (active() && d.targetKind=='profile' && pid(d.targetId) && d.targetGeneration=='' && exists(/databases/$(database)/documents/publicProfiles/$(d.targetId)) && id=='profile_'+d.targetId+'_'+request.auth.uid) ||
   (active() && d.targetKind=='thread' && d.targetId is string && d.targetId.size()<=180 && d.targetGeneration=='' && member(get(/databases/$(database)/documents/threads/$(d.targetId)).data) && id=='thread_'+d.targetId+'_'+request.auth.uid) ||
   (signed() && d.targetKind=='appeal' && d.targetId==request.auth.uid && blocked(request.auth.uid) && d.targetGeneration==get(/databases/$(database)/documents/userBlocks/$(request.auth.uid)).data.lastAuditId && id=='appeal_'+request.auth.uid+'_'+d.targetGeneration);
  }
  function reportCreate(d,id){return signed() && d.keys().hasAll(['reporterUid','targetKind','targetId','targetGeneration','category','text','status','resolution','handledBy','lastAuditId','createdAt','updatedAt']) && d.keys().hasOnly(['reporterUid','targetKind','targetId','targetGeneration','category','text','status','resolution','handledBy','lastAuditId','createdAt','updatedAt']) && d.reporterUid==request.auth.uid && d.category in ['fraud','spam','prohibited','other'] && d.text is string && d.text.size()>=10 && d.text.size()<=1500 && d.status=='open' && d.resolution=='' && d.handledBy=='' && d.lastAuditId=='' && d.createdAt==request.time && d.updatedAt==request.time && reportTarget(d,id);}
  function reportUpdate(d,id){return staff() && d.diff(resource.data).affectedKeys().hasOnly(['status','resolution','handledBy','lastAuditId','updatedAt']) && d.status in ['reviewing','resolved','rejected'] && d.status!=resource.data.status && resource.data.status in ['open','reviewing'] && reasonOK(d.resolution) && d.handledBy==request.auth.uid && uuid(d.lastAuditId) && d.updatedAt==request.time && auditMatches(d.lastAuditId,'report-update','report',id,'',d.resolution);}
  match /reports/{id}{
   allow get:if signed() && (resource.data.reporterUid==request.auth.uid || staff());
   allow list:if bounded(50) && signed() && (resource.data.reporterUid==request.auth.uid || staff());
   allow create:if reportCreate(request.resource.data,id);
   allow update:if reportUpdate(request.resource.data,id);
   allow delete:if false;
  }
  function auditRole(d,id){let after=getAfter(/databases/$(database)/documents/staff/$(d.targetId)).data;return root() && d.targetId!=request.auth.uid && roleOf(d.targetId)!='owner' && d.targetGeneration=='' && after.lastAuditId==id && after.role==d.to && roleOf(d.targetId)==d.from && after.role in ['admin','moderator','none'];}
  function auditBlock(d,id){let after=getAfter(/databases/$(database)/documents/userBlocks/$(d.targetId)).data;return manager() && d.targetGeneration=='' && after.lastAuditId==id && after.reason==d.reason && string(blocked(d.targetId))==d.from && string(after.blocked)==d.to && ((d.action=='user-block' && after.blocked==true)||(d.action=='user-unblock' && after.blocked==false));}
  function auditLot(d,id){let before=get(/databases/$(database)/documents/lots/$(d.targetId)).data;let after=getAfter(/databases/$(database)/documents/lots/$(d.targetId)).data;return staff() && before.id==d.targetGeneration && after.id==before.id && after.lastAuditId==id && after.moderationReason==d.reason && visibility(before)==d.from && after.visibility==d.to && ((d.action=='lot-hide' && d.to=='hidden') || (d.action=='lot-show' && d.to=='active'));}
  function auditDelete(d,id){return manager() && id=='delete_'+d.targetId+'_'+d.targetGeneration && get(/databases/$(database)/documents/lots/$(d.targetId)).data.id==d.targetGeneration && !existsAfter(/databases/$(database)/documents/lots/$(d.targetId)) && d.to=='deleted' && d.from==visibility(get(/databases/$(database)/documents/lots/$(d.targetId)).data);}
  function auditReport(d,id){let before=get(/databases/$(database)/documents/reports/$(d.targetId)).data;let after=getAfter(/databases/$(database)/documents/reports/$(d.targetId)).data;return staff() && after.lastAuditId==id && before.status==d.from && after.status==d.to && after.resolution==d.reason && after.handledBy==request.auth.uid && d.targetGeneration=='';}
  function auditCreate(d,id){return staff() && d.keys().hasAll(['actorUid','action','targetKind','targetId','targetGeneration','reason','from','to','createdAt']) && d.keys().hasOnly(['actorUid','action','targetKind','targetId','targetGeneration','reason','from','to','createdAt']) && d.actorUid==request.auth.uid && d.createdAt==request.time && reasonOK(d.reason) && d.targetId is string && d.targetId.size()<=220 && d.from is string && d.from.size()<=30 && d.to is string && d.to.size()<=80 && (
   (d.targetKind=='promo' && d.action in ['promo-save','promo-delete'] && auditPromo(d,id)) ||
   (d.targetKind=='review' && d.action in ['review-hide','review-show'] && auditReview(d,id)) ||
   (d.action=='role-set' && d.targetKind=='user' && uuid(id) && auditRole(d,id)) ||
   (d.action in ['user-block','user-unblock'] && d.targetKind=='user' && uuid(id) && auditBlock(d,id)) ||
   (d.action in ['lot-hide','lot-show'] && d.targetKind=='lot' && uuid(id) && auditLot(d,id)) ||
   (d.action=='lot-delete' && d.targetKind=='lot' && auditDelete(d,id)) ||
   (d.action=='report-update' && d.targetKind=='report' && uuid(id) && auditReport(d,id)));
  }
  match /auditLog/{id}{allow get:if staff();allow list:if staff() && bounded(50);allow create:if auditCreate(request.resource.data,id);allow update,delete:if false;}


  function reviewOK(d,seller,id){let deal=get(/databases/$(database)/documents/deals/$(id)).data;return active() && uuid(id) && d.keys().hasAll(['dealId','authorId','sellerId','rating','text','hidden','createdAt','updatedAt']) && d.keys().hasOnly(['dealId','authorId','sellerId','rating','text','hidden','createdAt','updatedAt']) && d.dealId==id && d.authorId==deal.buyerId && owner(d.authorId) && d.sellerId==seller && deal.sellerId==seller && d.authorId!=seller && deal.status=='completed' && deal.buyerConfirmed && deal.sellerConfirmed && d.rating is int && d.rating>=1 && d.rating<=5 && d.text is string && d.text.size()>=10 && d.text.size()<=1000 && d.hidden==false && d.createdAt==request.time && d.updatedAt==request.time;}
  match /publicProfiles/{seller}/reviews/{id}{
   allow get:if !exists(/databases/$(database)/documents/publicProfiles/$(seller)/reviews/$(id)) || resource.data.hidden==false || staff() || owner(resource.data.authorId) || owner(seller);
   allow list:if bounded(50) && (resource.data.hidden==false || staff());
   allow create:if queued('review',id,seller) && reviewOK(request.resource.data,seller,id);
   allow update:if
    (active() && owner(seller) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['response','responseAt']) && request.resource.data.response is string && request.resource.data.response.size()>=1 && request.resource.data.response.size()<=600 && request.resource.data.responseAt==request.time) ||
    (queued('review',id,seller) && staff() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden','moderationReason','moderatedAt','lastAuditId']) && request.resource.data.hidden is bool && request.resource.data.hidden!=resource.data.hidden && reasonOK(request.resource.data.moderationReason) && request.resource.data.moderatedAt==request.time && uuid(request.resource.data.lastAuditId) && auditMatches(request.resource.data.lastAuditId,request.resource.data.hidden?'review-hide':'review-show','review',seller+'_'+id,'',request.resource.data.moderationReason));
   allow delete:if false;
  }
  function promoOK(d,id){return id.matches('[0-9]') && d.keys().hasAll(['title','subtitle','buttonText','href','enabled','startsAt','endsAt','hasImage','imageVersion','createdAt','updatedAt','lastAuditId']) && d.keys().hasOnly(['title','subtitle','buttonText','href','enabled','startsAt','endsAt','hasImage','imageVersion','createdAt','updatedAt','lastAuditId']) && d.title is string && d.title.size()>=3 && d.title.size()<=70 && d.subtitle is string && d.subtitle.size()<=180 && d.buttonText is string && d.buttonText.size()<=24 && d.href is string && d.href.size()<=500 && (d.href=='' || d.href.matches('https://[^\\s]+')) && d.enabled is bool && d.startsAt is timestamp && d.endsAt is timestamp && d.endsAt>d.startsAt && d.hasImage is bool && d.imageVersion is string && ((d.hasImage && uuid(d.imageVersion) && getAfter(/databases/$(database)/documents/promoImages/$(id)).data.version==d.imageVersion) || (!d.hasImage && d.imageVersion=='' && !existsAfter(/databases/$(database)/documents/promoImages/$(id)))) && d.createdAt is timestamp && d.updatedAt==request.time && uuid(d.lastAuditId) && auditMatches(d.lastAuditId,'promo-save','promo',id,'',getAfter(/databases/$(database)/documents/auditLog/$(d.lastAuditId)).data.reason);}
  match /promos/{id}{
   allow get:if manager() || resource.data.enabled==true;
   allow list:if bounded(10) && (manager() || resource.data.enabled==true);
   allow create:if manager() && promoOK(request.resource.data,id) && request.resource.data.createdAt==request.time;
   allow update:if manager() && promoOK(request.resource.data,id) && request.resource.data.createdAt==resource.data.createdAt;
   allow delete:if manager() && !existsAfter(/databases/$(database)/documents/promoImages/$(id)) && auditMatches('promo_delete_'+id+'_'+resource.data.lastAuditId,'promo-delete','promo',id,'',getAfter(/databases/$(database)/documents/auditLog/$('promo_delete_'+id+'_'+resource.data.lastAuditId)).data.reason);
  }
  match /promoImages/{id}{
   allow get:if manager() || get(/databases/$(database)/documents/promos/$(id)).data.enabled==true;
   allow list:if false;
   allow create,update:if manager() && request.resource.data.keys().hasAll(['version','data','updatedAt']) && request.resource.data.keys().hasOnly(['version','data','updatedAt']) && uuid(request.resource.data.version) && request.resource.data.data is string && request.resource.data.data.size()<=245760 && request.resource.data.data.matches('data:image/webp;base64,[A-Za-z0-9+/=]+') && request.resource.data.updatedAt==request.time && getAfter(/databases/$(database)/documents/promos/$(id)).data.hasImage && getAfter(/databases/$(database)/documents/promos/$(id)).data.imageVersion==request.resource.data.version;
   allow delete:if manager() && (!existsAfter(/databases/$(database)/documents/promos/$(id)) || getAfter(/databases/$(database)/documents/promos/$(id)).data.hasImage==false);
  }
  match /users/{uid}/preferences/{id}{allow get:if signed() && request.auth.uid==uid;allow list,delete:if false;allow create,update:if signed() && request.auth.uid==uid && id=='ui' && request.resource.data.keys().hasOnly(['soundEnabled','updatedAt']) && request.resource.data.soundEnabled is bool && request.resource.data.updatedAt==request.time;}
  function auditPromo(d,id){return manager() && d.targetGeneration=='' && d.targetId.matches('[0-9]') && ((d.action=='promo-save' && uuid(id) && getAfter(/databases/$(database)/documents/promos/$(d.targetId)).data.lastAuditId==id && d.to==(getAfter(/databases/$(database)/documents/promos/$(d.targetId)).data.enabled?'enabled':'disabled')) || (d.action=='promo-delete' && exists(/databases/$(database)/documents/promos/$(d.targetId)) && id=='promo_delete_'+d.targetId+'_'+get(/databases/$(database)/documents/promos/$(d.targetId)).data.lastAuditId && !existsAfter(/databases/$(database)/documents/promos/$(d.targetId)) && d.to=='deleted'));}
  function auditReview(d,id){let after=getAfter(/databases/$(database)/documents/publicProfiles/$(d.from)/reviews/$(d.to)).data;return staff() && uuid(id) && d.targetId==d.from+'_'+d.to && d.targetGeneration=='' && after.lastAuditId==id && after.moderationReason==d.reason && ((d.action=='review-hide' && after.hidden==true)||(d.action=='review-show' && after.hidden==false));}
  function threadDeal(d){let deal=get(/databases/$(database)/documents/deals/$(d.get('dealId',''))).data;return uuid(d.get('dealId','')) && member(deal) && d.sellerId==deal.sellerId && d.buyerId==deal.buyerId && d.lotDoc==deal.lotDoc && d.lotGenerationId==deal.lotGenerationId && d.itemKey==deal.itemKey && d.title==deal.title;}

  function who(){return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.publicId;}
  function owner(id){return signed() && who()==id;}
  function member(d){return signed() && who() in d.members;}
  function pid(id){return id is string && id.matches('[A-Za-z0-9]{20}');}
  function uuid(id){return id is string && id.matches('[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}');}
  function bounded(n){return request.query.limit!=null && request.query.limit<=n;}
  function validItem(k){return (k.matches("a.*") && k in ["acacia_boat","acacia_hanging_sign","acacia_leaves","acacia_log","acacia_planks","acacia_sapling","acacia_shelf","acacia_sign","acacia_slab","acacia_stairs","acacia_wood","activator_rail","allium","amethyst_block","amethyst_cluster","amethyst_shard","ancient_debris","andesite","andesite_slab","andesite_stairs","angler_pottery_sherd","anvil","apple","archer_pottery_sherd","armadillo_scute","armor_stand","arms_up_pottery_sherd","arrow","axolotl_bucket","azalea","azalea_leaves","azure_bluet"]) || (k.matches("b.*") && k in ["baked_potato","bamboo","bamboo_block","bamboo_hanging_sign","bamboo_mosaic","bamboo_mosaic_slab","bamboo_mosaic_stairs","bamboo_planks","bamboo_raft","bamboo_shelf","bamboo_sign","bamboo_slab","bamboo_stairs","barrel","basalt","beacon","bee_nest","beef","beehive","beetroot","beetroot_seeds","beetroot_soup","bell","big_dripleaf","birch_boat","birch_hanging_sign","birch_leaves","birch_log","birch_planks","birch_sapling","birch_shelf","birch_sign","birch_slab","birch_stairs","birch_wood","black_banner","black_bed","black_bundle","black_candle","black_carpet","black_concrete","black_concrete_powder","black_dye","black_glazed_terracotta","black_harness","black_shulker_box","black_stained_glass","black_stained_glass_pane","black_terracotta","black_wool","blackstone","blackstone_slab","blackstone_stairs","blade_pottery_sherd","blast_furnace","blaze_powder","blaze_rod","blue_banner","blue_bed","blue_bundle","blue_candle","blue_carpet","blue_concrete","blue_concrete_powder","blue_dye","blue_egg","blue_glazed_terracotta","blue_harness","blue_ice","blue_orchid","blue_shulker_box","blue_stained_glass","blue_stained_glass_pane","blue_terracotta","blue_wool","bolt_armor_trim_smithing_template","bone","bone_block","bone_meal","book","bookshelf","bordure_indented_banner_pattern","bow","bowl","brain_coral","brain_coral_block","brain_coral_fan","bread","breeze_rod","brewer_pottery_sherd","brewing_stand","brick